---
import '../styles/dashboard.css';
import { LayoutDashboard, PenSquare, Table2, Tags, LogOut } from 'lucide-react';

interface Props { title: string; subtitle?: string }
const { title, subtitle } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/dashboard', label: 'Overview', icon: LayoutDashboard, active: path === '/dashboard' },
  { href: '/dashboard/posts/new', label: 'Create Blog', icon: PenSquare, active: path === '/dashboard/posts/new' },
  { href: '/dashboard/posts', label: 'List Blog', icon: Table2, active: path === '/dashboard/posts' || /^\/dashboard\/posts\/[^/]+\/edit/.test(path) },
  { href: '/dashboard/categories', label: 'Categories', icon: Tags, active: path.startsWith('/dashboard/categories') },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} | Minor Moon CMS</title>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-800">
    <aside class="fixed inset-y-0 left-0 w-64 bg-slate-950 text-slate-300 hidden lg:flex flex-col p-5 overflow-hidden">
      <div class="absolute -top-24 -left-24 size-64 rounded-full bg-indigo-600/30 blur-3xl pointer-events-none"></div>
      <div class="relative flex items-center gap-3 mb-10">
        <div class="size-10 rounded-xl bg-gradient-to-br from-indigo-500 to-fuchsia-500 grid place-items-center">🌙</div>
        <span class="font-bold text-white text-lg">Minor Moon</span>
      </div>
      <nav class="relative flex-1 space-y-1" aria-label="Menu utama">
        {nav.map(({ href, label, icon: Icon, active }) => (
          <a href={href} aria-current={active ? 'page' : undefined}
            class:list={['flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-medium transition',
              active ? 'bg-gradient-to-r from-indigo-500 to-fuchsia-500 text-white shadow-lg shadow-indigo-500/20' : 'hover:bg-white/5 hover:text-white']}>
            <Icon size={18} /> {label}
          </a>
        ))}
      </nav>
      <form method="post" action="/api/auth/logout" class="relative">
        <button class="w-full flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-medium hover:bg-white/5 hover:text-white transition">
          <LogOut size={18} /> Keluar
        </button>
      </form>
    </aside>

    <div class="lg:pl-64">
      <header class="lg:hidden sticky top-0 z-20 bg-slate-950 px-4 py-3 flex gap-1 overflow-x-auto">
        {nav.map(({ href, label, active }) => (
          <a href={href} class:list={['whitespace-nowrap rounded-lg px-3 py-1.5 text-sm font-medium', active ? 'bg-indigo-500 text-white' : 'text-slate-300']}>{label}</a>
        ))}
      </header>
      <main class="p-4 sm:p-8 max-w-6xl mx-auto">
        <div class="mb-8">
          <h1 class="text-3xl font-bold tracking-tight text-slate-900">{title}</h1>
          {subtitle && <p class="text-slate-500 mt-1">{subtitle}</p>}
        </div>
        <slot />
      </main>
    </div>
  </body>
</html>
