---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import PostForm from '../../../components/PostForm.jsx';
import { admin } from '../../../db/admin';

const [{ data: categories }, { data: authors }, { data: websites }] = await Promise.all([
  admin.from('categories').select('id,name').order('name'),
  admin.from('authors').select('id,name').order('name'),
  admin.from('websites').select('id,name').order('name'),
]);
---

<DashboardLayout title="Create Blog" subtitle="Tulis artikel baru.">
  <PostForm client:load categories={categories ?? []} authors={authors ?? []} websites={websites ?? []} defaultAuthorId={Astro.locals.user!.id} />
</DashboardLayout>
