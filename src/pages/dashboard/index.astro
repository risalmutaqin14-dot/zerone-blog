---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ChartCard from "../../components/ChartCard.astro";
import CalendarWidget from "../../components/CalendarWidget.astro";
import ViewButton from "../../components/ViewButton.jsx";
import DeleteButton from "../../components/DeleteButton.jsx";
import { admin } from "../../db/admin";
import { fmtDate, postStatus, STATUS_STYLE } from "../../lib/format";
import { parseMode, parseRange, SITE_COLORS } from "../../lib/chart";
import { parseMonth, shiftMonth } from "../../lib/calendar";
import {
    FileText,
    CheckCircle2,
    CalendarClock,
    PencilLine,
    Plus,
    Pencil,
    KeyRound,
    Globe,
    ArrowRight,
} from "lucide-react";

const range = parseRange(Astro.url.searchParams.get("range"));
const mode = parseMode(Astro.url.searchParams.get("mode"));
const calMonth = parseMonth(Astro.url.searchParams.get("cal"));
// Link yang mempertahankan pilihan lain (mode, range, bulan kalender) kecuali yang diganti.
const link = (o: Record<string, string>) => `?${new URLSearchParams({ mode, range, cal: calMonth, ...o })}`;
const now = new Date().toISOString();

const count = async (f: (q: any) => any) => {
    const { count } = await f(
        admin.from("posts").select("id", { count: "exact", head: true }),
    );
    return count ?? 0;
};
const [total, published, scheduled, draft, recent, sites, drafts] =
    await Promise.all([
        count((q) => q),
        count((q) => q.eq("status", "published").lte("published_at", now)),
        count((q) => q.eq("status", "published").gt("published_at", now)),
        count((q) => q.eq("status", "draft")),
        admin
            .from("posts")
            .select("id,title,status,published_at,updated_at,website_id,website:websites(name)")
            .order("updated_at", { ascending: false })
            .limit(5),
        admin.from("websites").select("id,name,api_key_hash,posts(count)").order("name"),
        admin
            .from("posts")
            .select("id,title,updated_at,website_id,website:websites(name)")
            .eq("status", "draft")
            .order("updated_at", { ascending: false })
            .limit(5),
    ]);

const websites = (sites.data ?? []).map((w: any, i: number) => ({
    id: w.id as string,
    name: w.name as string,
    posts: (w.posts?.[0]?.count ?? 0) as number,
    hasKey: !!w.api_key_hash,
    color: SITE_COLORS[i % SITE_COLORS.length],
}));
const colorOf = (id: string) => websites.find((w) => w.id === id)?.color ?? "#94a3b8";


const cards = [
    { label: "Total posts", value: total, icon: FileText, grad: "from-brand-1 to-cyan-400" },
    { label: "Published", value: published, icon: CheckCircle2, grad: "from-emerald-500 to-teal-400" },
    { label: "Scheduled", value: scheduled, icon: CalendarClock, grad: "from-amber-500 to-orange-400" },
    { label: "Draft", value: draft, icon: PencilLine, grad: "from-violet-500 to-fuchsia-500" },
];
const card = "rounded-3xl bg-white shadow-sm ring-1 ring-slate-200/70";
---

<DashboardLayout title="Overview" subtitle="Ringkasan konten blog kamu.">
    <a slot="actions" href="/dashboard/posts/new" class="inline-flex items-center gap-2 rounded-xl bg-linear-to-r from-brand-1 to-brand-2 px-4 py-2.5 text-sm font-semibold text-white shadow-md shadow-brand-1/25 transition hover:shadow-lg hover:brightness-105">
        <Plus size={16} /> Create Blog
    </a>

    <div class="mt-6 grid grid-cols-2 lg:grid-cols-4 gap-4">
        {cards.map(({ label, value, icon: Icon, grad }) => (
            <div class={`relative overflow-hidden rounded-3xl bg-linear-to-br ${grad} p-5 text-white shadow-md`}>
                <Icon size={88} className="absolute -right-4 -bottom-4 opacity-20" />
                <div class="relative">
                    <div class="size-10 rounded-xl bg-white/20 grid place-items-center backdrop-blur">
                        <Icon size={20} />
                    </div>
                    <p class="mt-4 text-4xl font-bold tracking-tight">{value}</p>
                    <p class="text-sm text-white/85">{label}</p>
                </div>
            </div>
        ))}
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <section id="chart-card" class={`${card} min-w-0 p-5 sm:p-6`}>
            <ChartCard mode={mode} range={range} cal={calMonth} />
        </section>

        <section class={`${card} flex min-w-0 flex-col p-5 sm:p-6`}>
            <CalendarWidget
                month={calMonth}
                prev={link({ cal: shiftMonth(calMonth, -1) })}
                next={link({ cal: shiftMonth(calMonth, 1) })}
            />
        </section>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {websites.map((w) => (
            <a
                href="/dashboard/websites"
                class={`group relative overflow-hidden ${card} p-5 transition hover:-translate-y-0.5 hover:shadow-md`}
            >
                <div class="absolute inset-x-0 top-0 h-1.5" style={`background:${w.color}`}></div>
                <div class="flex items-center justify-between">
                    <span class="size-10 rounded-xl grid place-items-center text-white" style={`background:${w.color}`}>
                        <Globe size={20} />
                    </span>
                    <span
                        class:list={[
                            "inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset",
                            w.hasKey
                                ? "bg-emerald-50 text-emerald-700 ring-emerald-600/20"
                                : "bg-amber-50 text-amber-700 ring-amber-600/20",
                        ]}
                    >
                        <KeyRound size={12} />
                        {w.hasKey ? "Key active" : "No key"}
                    </span>
                </div>
                <p class="mt-4 text-3xl font-bold text-slate-900">{w.posts}</p>
                <p class="text-sm text-slate-500">{w.name} · posts</p>
            </a>
        ))}
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-2">
        <section class={card}>
            <div class="flex items-center justify-between gap-3 p-5 border-b border-slate-100">
                <h2 class="font-semibold text-slate-900 flex items-center gap-2">
                    Unfinished drafts
                    <span class="rounded-full bg-violet-100 px-2 py-0.5 text-xs font-semibold text-violet-700">
                        {draft}
                    </span>
                </h2>
                {draft > 5 && (
                    <a
                        href="/dashboard/posts?status=draft"
                        class="inline-flex items-center gap-1 text-sm font-medium text-brand-1 hover:underline"
                    >
                        View all <ArrowRight size={14} />
                    </a>
                )}
            </div>
            {drafts.data?.length ? (
                <ul class="divide-y divide-slate-100">
                    {drafts.data.map((p: any) => (
                        <li class="flex items-center justify-between gap-3 px-5 py-3">
                            <div class="min-w-0">
                                <p class="truncate font-medium text-slate-800">{p.title}</p>
                                <p class="mt-0.5 flex items-center gap-2 text-xs text-slate-400">
                                    <span
                                        class="rounded-full px-2 py-0.5 font-medium text-white"
                                        style={`background:${colorOf(p.website_id)}`}
                                    >
                                        {p.website?.name}
                                    </span>
                                    {fmtDate(p.updated_at)}
                                </p>
                            </div>
                            <div class="flex shrink-0 gap-1">
                                <ViewButton client:load id={p.id} label={p.title} />
                                <a
                                    href={`/dashboard/posts/${p.id}/edit`}
                                    aria-label={`Edit ${p.title}`}
                                    title="Edit"
                                    class="rounded-lg p-2 text-slate-500 hover:bg-brand-1/10 hover:text-brand-1"
                                >
                                    <Pencil size={16} />
                                </a>
                                <DeleteButton client:load endpoint={`/api/admin/posts/${p.id}`} label={p.title} />
                            </div>
                        </li>
                    ))}
                </ul>
            ) : (
                <p class="p-10 text-center text-slate-500">No drafts. All caught up.</p>
            )}
        </section>

        <section class={card}>
            <div class="flex items-center justify-between p-5 border-b border-slate-100">
                <h2 class="font-semibold text-slate-900">Terakhir diubah</h2>
                <a
                    href="/dashboard/posts"
                    class="inline-flex items-center gap-1 text-sm font-medium text-brand-1 hover:underline"
                >
                    List Blog <ArrowRight size={14} />
                </a>
            </div>
            {recent.data?.length ? (
                <ul class="divide-y divide-slate-100">
                    {recent.data.map((p: any) => {
                        const s = postStatus(p);
                        return (
                            <li>
                                <a
                                    href={`/dashboard/posts/${p.id}/edit`}
                                    class="flex items-center justify-between gap-3 px-5 py-3.5 hover:bg-slate-50"
                                >
                                    <div class="min-w-0">
                                        <p class="truncate font-medium text-slate-800">{p.title}</p>
                                        <p class="mt-0.5 flex items-center gap-2 text-xs text-slate-400">
                                            <span
                                                class="rounded-full px-2 py-0.5 font-medium text-white"
                                                style={`background:${colorOf(p.website_id)}`}
                                            >
                                                {p.website?.name}
                                            </span>
                                            {fmtDate(p.updated_at)}
                                        </p>
                                    </div>
                                    <span
                                        class={`shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset capitalize ${STATUS_STYLE[s]}`}
                                    >
                                        {s}
                                    </span>
                                </a>
                            </li>
                        );
                    })}
                </ul>
            ) : (
                <p class="p-10 text-center text-slate-500">Belum ada post.</p>
            )}
        </section>
    </div>

    <script>
        // Ganti mode/range: ambil hanya kartu grafik (/dashboard/chart), tanpa reload halaman. Gagal -> navigasi biasa.
        const card = document.getElementById("chart-card")!;
        let ctrl: AbortController | undefined;

        card.addEventListener("click", async (e) => {
            const a = (e.target as Element).closest<HTMLAnchorElement>("a[data-chart]");
            if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            e.preventDefault();
            if (a.getAttribute("aria-current") === "true") return;

            ctrl?.abort();
            ctrl = new AbortController();
            card.setAttribute("aria-busy", "true");
            card.classList.add("opacity-60", "transition-opacity");
            try {
                const res = await fetch(a.href.replace("/dashboard?", "/dashboard/chart?"), { signal: ctrl.signal });
                if (!res.ok || res.redirected) throw new Error(String(res.status)); // redirect = halaman penuh, bukan partial
                card.innerHTML = await res.text();
                history.replaceState(null, "", a.href); // refresh/bagikan URL tetap menampilkan mode yang sama
            } catch (err) {
                if ((err as Error).name !== "AbortError") location.href = a.href;
                return;
            } finally {
                card.removeAttribute("aria-busy");
                card.classList.remove("opacity-60");
            }
        });

        // Panah bulan kalender memuat ulang halaman: bawa mode/range yang sedang tampil, bukan yang di URL awal.
        document.querySelectorAll<HTMLAnchorElement>("a[data-calnav]").forEach((a) =>
            a.addEventListener("click", (e) => {
                const next = new URLSearchParams(location.search);
                next.set("cal", new URL(a.href).searchParams.get("cal")!);
                e.preventDefault();
                location.search = next.toString();
            }),
        );
    </script>
</DashboardLayout>
