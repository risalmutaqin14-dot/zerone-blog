---
import "../styles/dashboard.css";
import { SESSION_COOKIE, getSession } from "../lib/auth";
import PasswordInput from "../components/PasswordInput.jsx";
import PasskeyLogin from "../components/PasskeyLogin.jsx";

if (await getSession(Astro.cookies.get(SESSION_COOKIE)?.value))
    return Astro.redirect("/dashboard");
const err = Astro.url.searchParams.get("error");
const message =
    err === "rate"
        ? "Terlalu banyak percobaan. Coba lagi beberapa menit lagi."
        : err
          ? "Email atau password salah, atau akun terkunci sementara."
          : "";
---

<html lang="id">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="robots" content="noindex" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>Login | Blog Zerone CMS</title>
    </head>
    <body class="min-h-screen grid place-items-center bg-slate-950 relative overflow-hidden px-4">
        <div class="absolute -top-40 -left-40 w-96 h-96 rounded-full bg-brand-1/30 blur-3xl"></div>
        <div class="absolute -bottom-40 -right-40 w-96 h-96 rounded-full bg-brand-2/30 blur-3xl"></div>

        <form
            method="post"
            action="/api/auth/login"
            class="relative w-full max-w-sm rounded-3xl border border-white/10 bg-white/5 backdrop-blur-xl p-8 shadow-2xl"
        >
            <img
                src="/logo.png"
                alt="Blog Zerone"
                class="size-12 rounded-2xl object-contain mb-6"
            />
            <h1 class="text-2xl font-bold text-white">Blog Zerone CMS</h1>
            <p class="text-slate-400 text-sm mt-1 mb-6">
                Masuk untuk mengelola blog.
            </p>

            {message && (
                <p role="alert" class="mb-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-sm px-4 py-2.5">
                    {message}
                </p>
            )}

            <label for="email" class="block text-sm font-medium text-slate-300 mb-2">Email</label>
            <input
                id="email"
                name="email"
                type="email"
                required
                autofocus
                maxlength="254"
                autocomplete="username webauthn"
                class="w-full rounded-xl bg-white/5 border border-white/10 px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-1"
            />

            <label for="password" class="block text-sm font-medium text-slate-300 mb-2 mt-4">Password</label>
            <PasswordInput
                client:load
                id="password"
                name="password"
                required
                maxLength={128}
                autoComplete="current-password"
                iconClass="text-slate-400 hover:text-white"
                className="w-full rounded-xl bg-white/5 border border-white/10 px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-1"
            />
            <button class="mt-6 w-full rounded-xl bg-linear-to-r from-brand-1 to-brand-2 py-3 font-semibold text-white hover:opacity-90 transition focus:outline-none focus:ring-2 focus:ring-brand-2 focus:ring-offset-2 focus:ring-offset-slate-950">
                Masuk
            </button>
            <PasskeyLogin client:load />
        </form>
    </body>
</html>
