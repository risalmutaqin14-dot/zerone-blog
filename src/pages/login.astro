---
import '../styles/dashboard.css';
import { SESSION_COOKIE, verifySession } from '../lib/auth';

if (verifySession(Astro.cookies.get(SESSION_COOKIE)?.value)) return Astro.redirect('/dashboard');
const failed = Astro.url.searchParams.has('error');
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Login | Minor Moon CMS</title>
  </head>
  <body class="min-h-screen grid place-items-center bg-slate-950 relative overflow-hidden px-4">
    <div class="absolute -top-40 -left-40 w-96 h-96 rounded-full bg-indigo-600/30 blur-3xl"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 rounded-full bg-fuchsia-600/30 blur-3xl"></div>

    <form method="post" action="/api/auth/login" class="relative w-full max-w-sm rounded-3xl border border-white/10 bg-white/5 backdrop-blur-xl p-8 shadow-2xl">
      <div class="size-12 rounded-2xl bg-gradient-to-br from-indigo-500 to-fuchsia-500 grid place-items-center text-xl mb-6">🌙</div>
      <h1 class="text-2xl font-bold text-white">Minor Moon CMS</h1>
      <p class="text-slate-400 text-sm mt-1 mb-6">Masuk untuk mengelola blog.</p>

      {failed && <p class="mb-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-sm px-4 py-2.5">Password salah.</p>}

      <label for="password" class="block text-sm font-medium text-slate-300 mb-2">Password</label>
      <input id="password" name="password" type="password" required autofocus autocomplete="current-password"
        class="w-full rounded-xl bg-white/5 border border-white/10 px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
      <button class="mt-6 w-full rounded-xl bg-gradient-to-r from-indigo-500 to-fuchsia-500 py-3 font-semibold text-white hover:opacity-90 transition focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2 focus:ring-offset-slate-950">Masuk</button>
    </form>
  </body>
</html>
