---
// Isi kartu grafik Overview (tanpa pembungkus <section>). Dirender di halaman dan di partial /dashboard/chart,
// supaya ganti mode/range cukup mengganti kartu ini. Data: post terbit per website.
import "../styles/chart.css";
import { admin } from "../db/admin";
import {
    RANGES,
    rangeLabel,
    buildBuckets,
    countByBucket,
    cumulative,
    smoothPath,
    SITE_COLORS,
    type Mode,
    type Range,
} from "../lib/chart";

interface Props {
    mode: Mode;
    range: Range;
    cal: string;
}
const { mode, range, cal } = Astro.props;
const MODES = [["date", "Post per date"], ["total", "Total"]] as const;
const link = (o: Record<string, string>) => `/dashboard?${new URLSearchParams({ mode, range, cal, ...o })}`;

const { starts, labels, fromISO } = buildBuckets(range);
const now = new Date().toISOString();

// ponytail: .limit(10000) = batas baris per rentang; pindah ke agregasi SQL (rpc) bila post > 10rb.
const [sites, inRange] = await Promise.all([
    admin.from("websites").select("id,name").order("name"),
    admin
        .from("posts")
        .select("website_id,published_at")
        .eq("status", "published")
        .gte("published_at", fromISO)
        .lte("published_at", now)
        .limit(10000),
]);
const list = (sites.data ?? []) as { id: string; name: string }[];

// Mode total: titik awal = post terbit sebelum rentang, supaya garis kumulatif dimulai dari angka sebenarnya.
const bases =
    mode === "total"
        ? await Promise.all(
              list.map(async (w) => {
                  const { count } = await admin
                      .from("posts")
                      .select("id", { count: "exact", head: true })
                      .eq("website_id", w.id)
                      .eq("status", "published")
                      .lt("published_at", fromISO);
                  return count ?? 0;
              }),
          )
        : list.map(() => 0);

const series = list.map((w, i) => {
    const counts = countByBucket(
        starts,
        (inRange.data ?? []).filter((p: any) => p.website_id === w.id).map((p: any) => p.published_at),
    );
    return {
        name: w.name,
        color: SITE_COLORS[i % SITE_COLORS.length],
        values: mode === "total" ? cumulative(counts, bases[i]) : counts,
    };
});

const W = 640, H = 320, L = 40, R = 16, T = 16, B = 32;
const iw = W - L - R;
const ih = H - T - B;
const step = Math.ceil(Math.max(3, ...series.flatMap((s) => s.values)) / 4);
const yMax = step * 4;
const n = labels.length;
const x = (i: number) => (n < 2 ? L + iw / 2 : L + (i * iw) / (n - 1));
const y = (v: number) => T + ih - (v / yMax) * ih;
const xs = labels.map((_, i) => x(i));
const colW = n < 2 ? iw : iw / (n - 1);
const every = Math.ceil(n / 8);
const ticks = [0, 1, 2, 3, 4].map((i) => i * step);
const empty = series.every((s) => s.values.every((v) => v === 0));
const sum = (a: number[]) => a.reduce((p, c) => p + c, 0);
// date: jumlah di rentang. total: nilai kumulatif terakhir.
const stat = (s: { values: number[] }) => (mode === "total" ? (s.values.at(-1) ?? 0) : sum(s.values));
const grand = sum(series.map(stat));
const unit = mode === "total" ? "total" : "terbit";
---

<div class="chart-wrap">
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
            <h2 class="text-lg font-semibold text-slate-900">
                {mode === "total" ? "Total posts by website" : "Posts by website"}
            </h2>
            <p class="text-sm text-slate-500">
                {mode === "total" ? `${grand} published, kumulatif` : `${grand} published in this range`}
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <nav class="flex gap-1 rounded-2xl bg-slate-100 p-1" aria-label="Chart mode">
                {MODES.map(([m, text]) => (
                    <a
                        href={link({ mode: m })}
                        data-chart
                        aria-current={m === mode ? "true" : undefined}
                        class:list={[
                            "rounded-xl px-3 py-1.5 text-xs font-semibold whitespace-nowrap transition",
                            m === mode ? "bg-white text-brand-1 shadow-sm" : "text-slate-500 hover:text-slate-800",
                        ]}
                    >
                        {text}
                    </a>
                ))}
            </nav>
            <nav class="flex flex-wrap gap-1 rounded-2xl bg-slate-100 p-1" aria-label="Chart range">
                {RANGES.map((r) => (
                    <a
                        href={link({ range: r })}
                        data-chart
                        aria-current={r === range ? "true" : undefined}
                        class:list={[
                            "rounded-xl px-3 py-1.5 text-xs font-semibold transition",
                            r === range ? "bg-white text-brand-1 shadow-sm" : "text-slate-500 hover:text-slate-800",
                        ]}
                    >
                        {rangeLabel(r)}
                    </a>
                ))}
            </nav>
        </div>
    </div>

    <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {series.map((s) => (
            <li class="flex items-center gap-2">
                <span class="size-3 rounded-full" style={`background:${s.color}`}></span>
                <span class="font-medium text-slate-700">{s.name}</span>
                <span class="text-slate-400">{stat(s)}</span>
            </li>
        ))}
    </ul>


    <div class="relative mt-4">
        <svg
            viewBox={`0 0 ${W} ${H}`}
            role="img"
            aria-label={mode === "total" ? "Cumulative published posts per website" : "Published posts per website over time"}
            class="h-auto w-full"
        >
            <defs>
                {series.map((s, si) => (
                    <linearGradient id={`area-${si}`} x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color={s.color} stop-opacity="0.28" />
                        <stop offset="1" stop-color={s.color} stop-opacity="0" />
                    </linearGradient>
                ))}
            </defs>

            {ticks.map((v) => (
                <>
                    <line x1={L} x2={W - R} y1={y(v)} y2={y(v)} stroke="#e2e8f0" stroke-dasharray={v ? "4 4" : undefined} />
                    <text x={L - 8} y={y(v) + 4} text-anchor="end" font-size="11" fill="#94a3b8">{v}</text>
                </>
            ))}
            {labels.map((l, i) =>
                i % every === 0 ? (
                    <text x={x(i)} y={H - 10} text-anchor="middle" font-size="11" fill="#64748b">{l}</text>
                ) : null,
            )}

            {!empty &&
                series.map((s, si) => {
                    const d = smoothPath(xs, s.values.map(y));
                    return (
                        <>
                            {n > 1 && (
                                <path
                                    class="chart-area"
                                    style={`animation-delay:${si * 120 + 350}ms`}
                                    d={`${d}L${xs[n - 1]},${y(0)}L${xs[0]},${y(0)}Z`}
                                    fill={`url(#area-${si})`}
                                />
                            )}
                            <path
                                class="chart-line"
                                style={`animation-delay:${si * 120}ms`}
                                pathLength="1"
                                d={d}
                                fill="none"
                                stroke={s.color}
                                stroke-width="3"
                                stroke-linejoin="round"
                                stroke-linecap="round"
                            />
                        </>
                    );
                })}

            {!empty &&
                labels.map((l, i) => (
                    <g class="chart-col">
                        <rect x={x(i) - colW / 2} y={T} width={colW} height={ih} fill="transparent">
                            <title>{`${l}\n${series.map((s) => `${s.name}: ${s.values[i]} ${unit}`).join("\n")}`}</title>
                        </rect>
                        <line class="chart-guide" x1={x(i)} x2={x(i)} y1={T} y2={y(0)} stroke="#cbd5e1" stroke-dasharray="3 3" pointer-events="none" />
                        {series.map((s, si) => (
                            <g class="chart-pt" pointer-events="none">
                                <circle
                                    class="chart-dot"
                                    style={`animation-delay:${450 + si * 120 + i * 35}ms`}
                                    cx={x(i)}
                                    cy={y(s.values[i])}
                                    r="4.5"
                                    fill="#fff"
                                    stroke={s.color}
                                    stroke-width="2.5"
                                />
                            </g>
                        ))}
                    </g>
                ))}
        </svg>
        {empty && (
            <p class="absolute inset-0 grid place-items-center text-sm text-slate-500">
                No published posts in this range
            </p>
        )}
    </div>
</div>

