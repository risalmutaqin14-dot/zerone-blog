---
// SVG server-side, tanpa library. Tooltip lewat <title>.
interface Props {
    labels: string[];
    series: { name: string; color: string; counts: number[] }[];
}
const { labels, series } = Astro.props;

const W = 1200, H = 320, L = 40, R = 16, T = 16, B = 32;
const iw = W - L - R;
const ih = H - T - B;
const step = Math.ceil(Math.max(3, ...series.flatMap((s) => s.counts)) / 4);
const yMax = step * 4;
const x = (i: number) => (labels.length < 2 ? L + iw / 2 : L + (i * iw) / (labels.length - 1));
const y = (v: number) => T + ih - (v / yMax) * ih;
const every = Math.ceil(labels.length / 8);
const ticks = [0, 1, 2, 3, 4].map((i) => i * step);
const empty = series.every((s) => s.counts.every((c) => c === 0));
---

<div class="relative">
    <svg
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label="Published posts per website over time"
        class="w-full h-auto"
    >
        {ticks.map((v) => (
            <>
                <line
                    x1={L}
                    x2={W - R}
                    y1={y(v)}
                    y2={y(v)}
                    stroke="#e2e8f0"
                    stroke-dasharray={v ? "4 4" : undefined}
                />
                <text x={L - 8} y={y(v) + 4} text-anchor="end" font-size="11" fill="#94a3b8">
                    {v}
                </text>
            </>
        ))}
        {labels.map((l, i) =>
            i % every === 0 ? (
                <text x={x(i)} y={H - 10} text-anchor="middle" font-size="11" fill="#64748b">
                    {l}
                </text>
            ) : null,
        )}
        {!empty &&
            series.map((s) => (
                <>
                    <path
                        d={s.counts.map((c, i) => `${i ? "L" : "M"}${x(i)},${y(c)}`).join(" ")}
                        fill="none"
                        stroke={s.color}
                        stroke-width="3"
                        stroke-linejoin="round"
                        stroke-linecap="round"
                    />
                    {s.counts.map((c, i) => (
                        <>
                            <circle cx={x(i)} cy={y(c)} r="4.5" fill="#fff" stroke={s.color} stroke-width="2.5" />
                            <circle cx={x(i)} cy={y(c)} r="12" fill="transparent">
                                <title>{`${s.name} · ${labels[i]}: ${c} post${c === 1 ? "" : "s"}`}</title>
                            </circle>
                        </>
                    ))}
                </>
            ))}
    </svg>
    {empty && (
        <p class="absolute inset-0 grid place-items-center text-sm text-slate-500">
            No published posts in this range
        </p>
    )}
</div>
